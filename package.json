{
  "name": "jsonlint-plus",
  "displayName": "JSONLint+",
  "description": "Validate JSON with a custom lexer and parser and suggest quick fixes.",
  "version": "0.1.0",
  "publisher": "shakiba-nouri",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "JSONLint+",
      "properties": {
        "jsonlintPlus.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 3.11+ executable used by JSONLint+."
        },
        "jsonlintPlus.schemaPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local JSON Schema file, absolute or relative to the workspace folder. Requires the Python jsonschema package."
        }
      }
    },
    "commands": [
      {
        "command": "jsonlintPlus.showTokens",
        "title": "JSONLint+: Show Tokens"
      },
      {
        "command": "jsonlintPlus.showAst",
        "title": "JSONLint+: Show AST"
      }
    ]
  }
}
